# ============================================================
# StreamVault Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# TMDB API Key (required for metadata enrichment)
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Server port
PORT=3030

# Data directory for database, thumbnails, and transcode cache
DATA_DIR=./data
