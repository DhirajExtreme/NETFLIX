{
  "name": "ds-plix",
  "version": "1.0.0",
  "description": "Netflix-style local media streaming application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "scan": "node -e \"require('./src/services/scanner').scanAll()\"",
    "enrich": "node -e \"require('dotenv').config(); require('./src/services/scanner').enrichUnmatched()\"",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@ctrl/video-filename-parser": "^5.9.0",
    "@derhuerst/ffprobe-static": "5.3.0",
    "basic-ftp": "^6.0.1",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "ffmpeg-static": "5.3.0",
    "mime-types": "^2.1.35",
    "video.js": "8.24.1"
  }
}
